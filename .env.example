PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Upstream services this aggregator pulls OpenAPI specs from.
# Defaults (used when unset) are the in-cluster service names shown below. Note these are
# the *-api-chart services (the APIs); *-chart-service names belong to the UIs.
#
# For local development, point each at the port that service is running on. They all
# default to PORT=3000, so run them on distinct ports.
AGENT_API_URL="http://agent-api-chart.default.svc.cluster.local"
MEMORY_API_URL="http://memory-api-chart.default.svc.cluster.local"
ADMIN_API_URL="http://admin-api-chart.default.svc.cluster.local"
PORTAL_API_URL="http://portal-api-chart.default.svc.cluster.local"
DISTILLER_API_URL="http://memory-distiller-chart.default.svc.cluster.local"

# How long a fetched spec is reused before refetching (ms). Default 5 minutes.
SPEC_TTL_MS=300000

# Per-upstream HTTP timeout (ms). Kept short so one slow service cannot stall the page.
SPEC_FETCH_TIMEOUT_MS=5000

# Surfaced as labels on /metrics; set by the chart in the cluster.
OTEL_SERVICE_NAME=apidocs-api-server
ENVIRONMENT_ID=local
