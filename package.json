{
    "name": "bouc.io-apidocs-api-server",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "format": "prettier --write \"src/**/*.{ts,js,json}\""
    },
    "keywords": [
        "openapi",
        "swagger",
        "api-docs",
        "aggregator",
        "kubernetes"
    ],
    "author": "",
    "license": "Elastic-2.0",
    "description": "Aggregated OpenAPI documentation for the bouc.io platform. Fans out to each service's spec over the mesh and serves them behind one Swagger UI.",
    "dependencies": {
        "axios": "^1.10.0",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^4.21.2",
        "helmet": "^8.2.0",
        "pino": "^9.4.0",
        "prom-client": "^15.1.3",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.0.14",
        "@types/swagger-ui-express": "^4.1.8",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "typescript": "^5.8.3",
        "vitest": "^4.1.7"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/bouc-io/application/apidocs/apidocs-api-server.git"
    }
}
